# Instruction-tuning set for an API support domain. All text written for this repository.
{"id": "t01", "input": "", "instruction": "What is the default rate limit?", "output": "The default rate limit is 600 requests per minute per API key.", "split": "train"}
{"id": "t02", "input": "", "instruction": "How do I raise my rate limit?", "output": "Contact support to request a higher limit; enterprise plans can be raised on request.", "split": "train"}
{"id": "t03", "input": "", "instruction": "What status code means rate limited?", "output": "Exceeding the rate limit returns 429 with a Retry-After header.", "split": "train"}
{"id": "t04", "input": "", "instruction": "Are rate limits per key or per account?", "output": "Rate limits apply per API key rather than per account.", "split": "train"}
{"id": "t05", "input": "", "instruction": "How long do access tokens last?", "output": "Access tokens expire after one hour.", "split": "train"}
{"id": "t06", "input": "", "instruction": "How long do refresh tokens last?", "output": "Refresh tokens expire after thirty days.", "split": "train"}
{"id": "t07", "input": "", "instruction": "Can a refresh token be reused?", "output": "No. A refresh token is single use; exchanging it returns a new pair and invalidates the old one.", "split": "train"}
{"id": "t08", "input": "", "instruction": "What happens when a client is revoked?", "output": "Revoking a client invalidates every token it issued.", "split": "train"}
{"id": "t09", "input": "", "instruction": "Are tokens tied to a client?", "output": "Yes. Tokens are bound to the client that requested them.", "split": "train"}
{"id": "t10", "input": "", "instruction": "How long do refunds take?", "output": "Refunds are issued to the original payment method within five working days.", "split": "train"}
{"id": "t11", "input": "", "instruction": "Can I refund an uncaptured authorisation?", "output": "No. A refund cannot be issued against an authorisation that has not been captured.", "split": "train"}
{"id": "t12", "input": "", "instruction": "How are partial refunds tracked?", "output": "Partial refunds are tracked against a remaining balance held by the payment provider.", "split": "train"}
{"id": "t13", "input": "", "instruction": "Which exchange rate applies to a refund?", "output": "The rate on the day of the refund, not the day of purchase.", "split": "train"}
{"id": "t14", "input": "", "instruction": "When is the maintenance window?", "output": "The maintenance window runs from 02:00 to 04:00 UTC every second Sunday.", "split": "train"}
{"id": "t15", "input": "", "instruction": "What happens to writes during maintenance?", "output": "The write API returns 503 and reads are served from a replica.", "split": "train"}
{"id": "t16", "input": "", "instruction": "Are scheduled jobs affected by maintenance?", "output": "Scheduled jobs are paused and resume automatically afterwards.", "split": "train"}
{"id": "t17", "input": "", "instruction": "Can I change my maintenance window?", "output": "Enterprise customers can request an alternative window with two weeks notice.", "split": "train"}
{"id": "t18", "input": "", "instruction": "How long are event logs kept?", "output": "Event logs are retained for thirty days, then archived to cold storage for a year.", "split": "train"}
{"id": "t19", "input": "", "instruction": "How long are audit records kept?", "output": "Audit records are kept for seven years to meet reporting obligations.", "split": "train"}
{"id": "t20", "input": "", "instruction": "When are deleted records purged from backups?", "output": "Deleted records are purged from backups within thirty-five days.", "split": "train"}
{"id": "t21", "input": "", "instruction": "Are webhooks delivered exactly once?", "output": "No. Webhooks are delivered at least once, so receivers must tolerate duplicates.", "split": "train"}
{"id": "t22", "input": "", "instruction": "How long are webhooks retried?", "output": "Delivery is retried with exponential backoff for up to twenty-four hours.", "split": "train"}
{"id": "t23", "input": "", "instruction": "How do I verify a webhook signature?", "output": "Verify the signature against the raw request bytes, before parsing the payload.", "split": "train"}
{"id": "t24", "input": "", "instruction": "Can webhooks arrive out of order?", "output": "Yes. A refund event can arrive before the payment event it refers to.", "split": "train"}
{"id": "t25", "input": "", "instruction": "Which SSO protocols are supported?", "output": "Single sign-on supports SAML 2.0 and OpenID Connect.", "split": "train"}
{"id": "t26", "input": "", "instruction": "Can SSO groups map to roles?", "output": "Yes. Group membership can be mapped to roles during provisioning.", "split": "train"}
{"id": "t27", "input": "", "instruction": "What is just-in-time provisioning?", "output": "It creates an account on the first successful sign-in.", "split": "train"}
{"id": "t28", "input": "", "instruction": "What happens if I disable SSO?", "output": "Disabling SSO leaves existing accounts intact.", "split": "train"}
{"id": "t29", "input": "", "instruction": "Which export formats are available?", "output": "Exports are available as CSV, JSON Lines and Parquet.", "split": "train"}
{"id": "t30", "input": "", "instruction": "How are large exports delivered?", "output": "As a signed download link valid for one hour.", "split": "train"}
{"id": "t31", "input": "", "instruction": "Is export column order stable?", "output": "Yes. Column order is stable across versions so downstream parsers do not break.", "split": "train"}
{"id": "t32", "input": "", "instruction": "What is a severity one incident?", "output": "Severity one means a core flow is unavailable for many customers.", "split": "train"}
{"id": "t33", "input": "", "instruction": "What is a severity two incident?", "output": "Severity two covers degraded service or a broken secondary flow.", "split": "train"}
{"id": "t34", "input": "", "instruction": "Who can raise incident severity?", "output": "Anyone may raise severity; lowering it requires review.", "split": "train"}
{"id": "t35", "input": "", "instruction": "What data does the sandbox contain?", "output": "The sandbox mirrors production behaviour with synthetic data.", "split": "train"}
{"id": "t36", "input": "", "instruction": "When is sandbox data reset?", "output": "Sandbox data is reset every Sunday.", "split": "train"}
{"id": "t37", "input": "", "instruction": "Can sandbox keys be used in production?", "output": "No. Sandbox keys cannot be used against production endpoints.", "split": "train"}
