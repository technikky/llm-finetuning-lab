# This repository needs no credentials to run: every model is built from a config with random
# initialisation, so there is nothing to download and nothing to authenticate.
#
# These are only for the optional case of pointing `ftlab` at a real published checkpoint,
# which is not what the tests or the published numbers do. Copy to `.env` and fill in locally.
# `.env` is git-ignored. Never commit a real token.

# Read token for gated repositories on the Hugging Face Hub (e.g. Llama-2). Optional.
HF_TOKEN=

# Where to cache downloaded weights, if you download any.
HF_HOME=

# Set to 1 to fail loudly instead of reaching for the network.
HF_HUB_OFFLINE=0
